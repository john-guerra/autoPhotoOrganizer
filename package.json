{
  "name": "autogallery",
  "version": "2.8.13-alpha",
  "description": "Fast, local-first photo triage: plug in an SD card, cull with the keyboard, organize the best shots into dated album folders.",
  "main": "electron/main.js",
  "type": "module",
  "license": "MIT",
  "author": "John Alexis Guerra Gómez",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node server/index.js",
    "dev:ui": "vite ui",
    "electron:dev": "node scripts/dev.mjs --electron",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "electron:build": "npm run build && npm run rebuild:electron && electron-builder --mac --win --linux && npm run rebuild:node",
    "electron:build:mac": "npm run build && npm run rebuild:electron && electron-builder --mac && npm run rebuild:node",
    "build": "vite build ui",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "d3": "^7.9.0",
    "electron-updater": "^6.3.0",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "multi-auto-select": "^0.0.11",
    "reactive-widget-helper": "^0.0.3",
    "sharp": "^0.35.3",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@john-guerra/d3-zoomable-axis": "^0.0.3",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^4.2.19",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.johnguerra.autogallery",
    "productName": "AutoGallery",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "!server/**/*.test.js",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/better-sqlite3/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.photography"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "publish": {
      "provider": "github",
      "owner": "john-guerra",
      "repo": "autoPhotoOrganizer"
    }
  }
}
